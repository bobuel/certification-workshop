  "items": [
    {
      "id": "D01",
      "revision": 1,
      "domain_id": "D",
      "competency_ids": [
        "C1"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "A Harbor import reports 980 accepted and 20 rejected rows from a 1,000-row source. What should the administrator do before publishing?",
      "options": {
        "A": "Publish because most rows succeeded.",
        "B": "Inspect the rejection report and reconcile all source rows.",
        "C": "Delete the rejection report.",
        "D": "Retry until the accepted count increases."
      },
      "answer_key": "B",
      "rationale": "Rule 2 requires reconciling accepted plus rejected counts and reviewing rejections; a majority accepted is insufficient.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "DATA",
          "version": "1.0",
          "locator": "Rule 2"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "D02",
      "revision": 1,
      "domain_id": "D",
      "competency_ids": [
        "C1"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "A CSV has a first row containing field names. Which Harbor import setting preserves that row as column names?",
      "options": {
        "A": "header=false",
        "B": "header=true",
        "C": "overwrite=true",
        "D": "skip_errors=true"
      },
      "answer_key": "B",
      "rationale": "Rule 1 defines header=true. The other settings do not select header interpretation.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "DATA",
          "version": "1.0",
          "locator": "Rule 1"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "D03",
      "revision": 1,
      "domain_id": "D",
      "competency_ids": [
        "C1"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "An import contains an empty required customer_id. Under Harbor v1, what happens to that row?",
      "options": {
        "A": "It receives a generated customer ID.",
        "B": "It replaces the previous row.",
        "C": "It is rejected with a reason in the rejection report.",
        "D": "It is accepted as a null key."
      },
      "answer_key": "C",
      "rationale": "Rule 3 requires rejection of a missing required identifier; Harbor does not generate one.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "DATA",
          "version": "1.0",
          "locator": "Rule 3"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "D04",
      "revision": 1,
      "domain_id": "D",
      "competency_ids": [
        "C1"
      ],
      "type": "practical",
      "status": "approved",
      "prompt": "Prepare a publication decision for the supplied import report.",
      "setup": "Synthetic source: 1,000 rows; accepted: 980; rejected: 20 with missing customer_id. No live system.",
      "deliverable": "A short reconciliation and publication recommendation.",
      "rubric": [
        {
          "criterion": "Reconcile counts",
          "points": 2,
          "anchor": "2: explicitly accounts for all 1,000 rows; 1: identifies accepted/rejected counts without reconciliation; 0: ignores the gap."
        },
        {
          "criterion": "Resolve rejection decision",
          "points": 2,
          "anchor": "2: holds publication and requests source correction/review of missing IDs; 1: notes errors but no publication decision; 0: publishes without review."
        }
      ],
      "rationale": "The rubric observes the relevant documented action and verification behavior.",
      "max_score": 4,
      "source_refs": [
        {
          "source_id": "DATA",
          "version": "1.0",
          "locator": "Rules 1-4"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "D05",
      "revision": 1,
      "domain_id": "D",
      "competency_ids": [
        "C1"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "An administrator wants to inspect the first ten accepted rows without altering the dataset. Which documented action fits?",
      "options": {
        "A": "preview --limit 10",
        "B": "publish --force",
        "C": "delete --limit 10",
        "D": "retry --overwrite"
      },
      "answer_key": "A",
      "rationale": "Rule 4 defines a read-only preview command. Publishing, deleting and retrying have other effects.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "DATA",
          "version": "1.0",
          "locator": "Rule 4"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "D06",
      "revision": 1,
      "domain_id": "D",
      "competency_ids": [
        "C1"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "The accepted count plus rejected count does not equal the source row count. What is the appropriate publication decision?",
      "options": {
        "A": "Publish if the sample looks correct.",
        "B": "Publish and remove the source.",
        "C": "Assume duplicate rows account for the difference.",
        "D": "Hold publication and investigate the reconciliation gap."
      },
      "answer_key": "D",
      "rationale": "Rule 2 requires complete reconciliation before publication; no automatic duplicate explanation is supported.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "DATA",
          "version": "1.0",
          "locator": "Rule 2"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "R01",
      "revision": 1,
      "domain_id": "R",
      "competency_ids": [
        "C3"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "A recovery operator wants to modify an existing Harbor snapshot before restoring it. What does the documented snapshot behavior permit?",
      "options": {
        "A": "Edit snapshot rows in place.",
        "B": "Overwrite the snapshot with a live dataset.",
        "C": "Modify its contents after approval.",
        "D": "Restore its immutable contents to a new namespace."
      },
      "answer_key": "D",
      "rationale": "Rule 1 defines snapshots as immutable, and rule 2 defines restoration to a new namespace.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "REC",
          "version": "1.0",
          "locator": "Rules 1-2"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "R02",
      "revision": 1,
      "domain_id": "R",
      "competency_ids": [
        "C3"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "A restored dataset has been created in a new namespace. What must happen before clients are cut over?",
      "options": {
        "A": "Reconcile counts and verify access using the recovery checklist.",
        "B": "Delete the original immediately.",
        "C": "Skip verification because the restore completed.",
        "D": "Grant all users administrator access."
      },
      "answer_key": "A",
      "rationale": "Rule 3 requires reconciliation and access verification before cutover; restore completion is insufficient.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "REC",
          "version": "1.0",
          "locator": "Rule 3"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "R03",
      "revision": 1,
      "domain_id": "R",
      "competency_ids": [
        "C3"
      ],
      "type": "practical",
      "status": "approved",
      "prompt": "Prepare a recovery and cutover checklist for an immutable snapshot.",
      "setup": "Synthetic snapshot of 1,000 rows and an empty new namespace. No live system.",
      "deliverable": "Ordered restore, verification and cutover steps.",
      "rubric": [
        {
          "criterion": "Restore safely",
          "points": 2,
          "anchor": "2: restore into new namespace while preserving original; 1: new namespace with unclear preservation; 0: destructive overwrite."
        },
        {
          "criterion": "Verify before cutover",
          "points": 2,
          "anchor": "2: reconcile counts and verify access before cutover; 1: only one check; 0: immediate cutover."
        }
      ],
      "rationale": "The rubric observes the relevant documented action and verification behavior.",
      "max_score": 4,
      "source_refs": [
        {
          "source_id": "REC",
          "version": "1.0",
          "locator": "Rules 1-4"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "S01",
      "revision": 1,
      "domain_id": "S",
      "competency_ids": [
        "C2"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "A service account needs to read dataset orders and must not edit it. Which grant meets the documented requirement?",
      "options": {
        "A": "Workspace administrator",
        "B": "Dataset orders reader",
        "C": "Dataset orders writer",
        "D": "Workspace owner"
      },
      "answer_key": "B",
      "rationale": "Rule 1 specifies a dataset-specific reader role. The other roles grant excess authority.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "SEC",
          "version": "1.0",
          "locator": "Rule 1"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "S02",
      "revision": 1,
      "domain_id": "S",
      "competency_ids": [
        "C2"
      ],
      "type": "single_choice",
      "status": "approved",
      "prompt": "A service-account token was disclosed. Which action immediately invalidates that token under Harbor v1?",
      "options": {
        "A": "Rename the service account.",
        "B": "Change its description.",
        "C": "Revoke the token and create a replacement through the credential workflow.",
        "D": "Create a second token without revoking the first."
      },
      "answer_key": "C",
      "rationale": "Rule 2 requires revocation; account metadata changes and creating another token do not revoke it.",
      "max_score": 1,
      "source_refs": [
        {
          "source_id": "SEC",
          "version": "1.0",
          "locator": "Rule 2"
        }
      ],
      "enemy_groups": []
    },
    {
      "id": "S03",
      "revision": 1,
      "domain_id": "S",
      "competency_ids": [
        "C2"
      ],
      "type": "practical",
      "status": "approved",
      "prompt": "Prepare a least-privilege service-account access plan for dataset orders.",
      "setup": "Synthetic role matrix only. Account has no current grants; no credentials are required.",
      "deliverable": "Grant choice and verification plan.",
      "rubric": [
        {
          "criterion": "Select grant",
          "points": 2,
          "anchor": "2: dataset orders reader only; 1: reader plus unnecessary read grants; 0: grants write/admin."
        },
        {
          "criterion": "Verify boundaries",
          "points": 2,
          "anchor": "2: plans successful read and denied write checks; 1: only a successful read check; 0: no verification."
        }
      ],
      "rationale": "The rubric observes the relevant documented action and verification behavior.",
      "max_score": 4,
      "source_refs": [
        {
          "source_id": "SEC",
          "version": "1.0",
          "locator": "Rules 1-4"
        }
      ],
      "enemy_groups": []
    }
